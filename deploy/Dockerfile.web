# Compila el frontend y lo sirve con Caddy, que además hace de proxy hacia la API.

FROM node:22-bookworm-slim AS build
# El CLI de Prisma (generate y migrate deploy) necesita OpenSSL.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/api/prisma apps/api/prisma
COPY apps/api/prisma.config.ts apps/api/
RUN npm ci
COPY tsconfig.base.json ./
COPY apps/web apps/web
# Ruta relativa: frontend y API comparten dominio, así la cookie de refresh viaja.
ENV VITE_API_URL=/api
RUN npm run build -w @gestor-gastos/web

FROM caddy:2
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
