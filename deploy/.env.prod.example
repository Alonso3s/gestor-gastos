# Copiar a `deploy/.env` y completar. Ese archivo no se versiona.

# Dominio público (sin https://). Caddy pide el certificado para este nombre.
DOMAIN=gastos-ejemplo.duckdns.org

# PostgreSQL. La contraseña debe ser la misma en POSTGRES_PASSWORD y en DATABASE_URL.
# Usá solo letras y números: otros caracteres habría que codificarlos en la URL.
POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=gastos
DATABASE_URL=postgresql://gastos:cambia-esto@db:5432/gastos

# API
NODE_ENV=production
PORT=3000
# Un proxy delante de la API (Caddy).
TRUST_PROXY=1
CORS_ORIGIN=https://gastos-ejemplo.duckdns.org
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=genera-con-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
