# Copiar a deploy/.env y completar. Nunca subir deploy/.env al repositorio.

# Dominio público (DuckDNS) sin https://
DOMAIN=gastos-ejemplo.duckdns.org

POSTGRES_USER=gastos
# Generar con: openssl rand -hex 24 (solo letras y números, así no rompe la URL de conexión)
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=gastos

# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
