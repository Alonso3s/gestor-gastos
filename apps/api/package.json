  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
